DATABASE_URL=sqlite:///./fintrack.db
# Supabase example (keep the password only in your untracked .env):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_SSL_MODE=verify-full
# DATABASE_DISABLE_PREPARED_STATEMENTS=true
# Leave DATABASE_SSL_MODE unset for local SQLite. Production requires verify-full.
# DATABASE_SSL_MODE=verify-full
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_DISABLE_PREPARED_STATEMENTS=false
# Production: generate with py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
RATE_LIMIT_STORAGE_URI=memory://
# Set this to a separate high-entropy token for protected Prometheus scraping.
METRICS_TOKEN=replace-this-with-a-separate-random-token
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SAMESITE=lax
# For separate HTTPS Vercel and Render domains, set AUTH_COOKIE_SAMESITE=none.
